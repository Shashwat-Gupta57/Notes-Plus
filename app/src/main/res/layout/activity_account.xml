<?xml version="1.0" encoding="utf-8"?>
<!--
  The notes account, in three states shown one at a time by AccountActivity:
  panelSignIn (Google or email), panelVerify (email sent, waiting for the link) and
  panelAccount (profile, sync, Drive, sign out). Rows reuse the Settings card styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gallery_background"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarAccount"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Account"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ======================================================== SIGN IN -->
            <LinearLayout
                android:id="@+id/panelSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/settings_icon_tile"
                    android:backgroundTint="@color/tile_blue"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_cloud"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Your notes, on every phone"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Sign in to back up your notes and keep them in step across devices. Photos and recordings go to your own Google Drive."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:text="Continue with Google"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="or use your email"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fieldEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fieldPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Password"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmail"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Sign in" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="New here? Create an account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForgot"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forgot password?"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- ========================================================= VERIFY -->
            <LinearLayout
                android:id="@+id/panelVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/settings_icon_tile"
                    android:backgroundTint="@color/tile_green"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_info"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Check your inbox"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txtVerify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerified"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:text="I've tapped the link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResend"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Send the email again" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOtherAccount"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use another account"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- ======================================================== ACCOUNT -->
            <LinearLayout
                android:id="@+id/panelAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/settings_icon_tile"
                    android:backgroundTint="@color/tile_purple"
                    android:contentDescription="Profile picture"
                    android:padding="20dp"
                    android:src="@drawable/ic_person"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txtHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView style="@style/Settings.Header" android:text="Sync" />

                <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout android:id="@+id/rowSync" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_blue" android:src="@drawable/ic_cloud" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Notes" />
                                <TextView android:id="@+id/txtSyncStatus" style="@style/Settings.Subtitle" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sync now"
                                android:textColor="@color/brand_yellow"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View style="@style/Settings.Divider" />

                        <LinearLayout android:id="@+id/rowDrive" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_green" android:src="@drawable/ic_photo" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Photos and recordings" />
                                <TextView android:id="@+id/txtDriveStatus" style="@style/Settings.Subtitle" />
                            </LinearLayout>
                            <ImageView style="@style/Settings.Chevron" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/Settings.Header" android:text="Profile" />

                <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout android:id="@+id/rowUsername" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_orange" android:src="@drawable/ic_person" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Username" />
                                <TextView android:id="@+id/txtUsername" style="@style/Settings.Subtitle" />
                            </LinearLayout>
                            <ImageView style="@style/Settings.Chevron" />
                        </LinearLayout>

                        <View style="@style/Settings.Divider" />

                        <LinearLayout android:id="@+id/rowSignOut" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_gray" android:src="@drawable/ic_arrow_back" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Sign out" />
                                <TextView android:id="@+id/txtEmail" style="@style/Settings.Subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/Settings.Divider" />

                        <LinearLayout android:id="@+id/rowDelete" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/destructive" android:src="@drawable/ic_delete" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Delete account" android:textColor="@color/destructive" />
                                <TextView style="@style/Settings.Subtitle" android:text="Removes everything stored online" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Settings.Footer"
                    android:text="Your notes are stored in the Notes+ cloud and only your account can open them. Photos and recordings stay in your own Google Drive, in a Notes-plus folder." />
            </LinearLayout>
        </FrameLayout>

            <!-- ======================================================== THE APP (any state) -->
            <TextView style="@style/Settings.Header" android:text="Notes+" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/rowNoteLock" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_orange" android:src="@drawable/ic_lock" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Locked notes" />
                            <TextView android:id="@+id/txtNoteLock" style="@style/Settings.Subtitle" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout android:id="@+id/rowUpdate" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_green" android:src="@drawable/ic_update" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Check for updates" />
                            <TextView android:id="@+id/txtUpdateStatus" style="@style/Settings.Subtitle" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout android:id="@+id/rowAbout" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_gray" android:src="@drawable/ic_info" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="About" />
                            <TextView android:id="@+id/txtAboutVersion" style="@style/Settings.Subtitle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
