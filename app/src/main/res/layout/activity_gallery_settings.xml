<?xml version="1.0" encoding="utf-8"?>
<!--
  Vault settings as grouped cards: a coloured icon tile, a title and a one-line explanation
  per row. IDs are the ones GallerySettingsActivity binds; the main-vault-only sections are
  hidden in code for other vaults.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gallery_background"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Settings"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- ============================================================ SECURITY -->
            <TextView style="@style/Settings.Header" android:text="Security" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/optionChangeLock" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_blue" android:src="@drawable/ic_lock" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView android:id="@+id/optionChangeLockTitle" style="@style/Settings.Title" android:text="Change lock" />
                            <TextView style="@style/Settings.Subtitle" android:text="PIN, password or pattern for this vault" />
                        </LinearLayout>
                        <ImageView style="@style/Settings.Chevron" />
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_orange" android:src="@drawable/ic_timer" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="Auto-lock" />
                                <TextView style="@style/Settings.Subtitle" android:text="Lock the vault after you leave it" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/radioGroupAutoLock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="46dp"
                            android:layout_marginTop="10dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/radioImmediately"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="At once" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/radio30s"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="30 s" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/radio1m"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1 min" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================== VAULTS -->
            <LinearLayout
                android:id="@+id/sectionVaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Settings.Header" android:text="Vaults" />

                <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewVaults"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <LinearLayout android:id="@+id/btnAddVault" style="@style/Settings.Row">
                            <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_green" android:src="@drawable/ic_add" />
                            <LinearLayout style="@style/Settings.Texts">
                                <TextView style="@style/Settings.Title" android:text="New vault" />
                                <TextView style="@style/Settings.Subtitle" android:text="A separate space with its own lock" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView style="@style/Settings.Footer" android:text="Each vault opens with its own lock from the same secret gesture." />
            </LinearLayout>

            <!-- ========================================================== APPEARANCE -->
            <TextView style="@style/Settings.Header" android:text="Appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_purple" android:src="@drawable/ic_wallpaper" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Vault wallpaper" />
                            <TextView style="@style/Settings.Subtitle" android:text="Behind this vault's gallery" />
                        </LinearLayout>
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:paddingStart="62dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/btnVaultBgDefault" style="@style/Settings.Chip" android:text="Default" />
                            <Button android:id="@+id/btnVaultBgColor" style="@style/Settings.Chip" android:text="Colour" />
                            <Button android:id="@+id/btnVaultBgImage" style="@style/Settings.Chip" android:text="Image" />
                            <Button android:id="@+id/btnVaultBgVideo" style="@style/Settings.Chip" android:text="Video" />
                            <Button android:id="@+id/btnVaultBgUrl" style="@style/Settings.Chip" android:text="Link" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <View style="@style/Settings.Divider" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_teal" android:src="@drawable/ic_lock" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Lock screen wallpaper" />
                            <TextView style="@style/Settings.Subtitle" android:text="Shared by every vault" />
                        </LinearLayout>
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:paddingStart="62dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/btnLockBgDefault" style="@style/Settings.Chip" android:text="Default" />
                            <Button android:id="@+id/btnLockBgColor" style="@style/Settings.Chip" android:text="Colour" />
                            <Button android:id="@+id/btnLockBgImage" style="@style/Settings.Chip" android:text="Image" />
                            <Button android:id="@+id/btnLockBgVideo" style="@style/Settings.Chip" android:text="Video" />
                            <Button android:id="@+id/btnLockBgUrl" style="@style/Settings.Chip" android:text="Link" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/layoutLockBgOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:paddingStart="62dp"
                        android:paddingEnd="16dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checkLockBgBlur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Blur the image"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checkLockBgDim"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="Dim it for contrast"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== GOOGLE DRIVE -->
            <TextView style="@style/Settings.Header" android:text="Google Drive" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout
                    android:id="@+id/layoutGoogleDrive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_blue" android:src="@drawable/ic_cloud" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView
                                android:id="@+id/textDriveAccount"
                                style="@style/Settings.Title"
                                android:text="Not connected" />
                            <TextView
                                android:id="@+id/textDriveLastSync"
                                style="@style/Settings.Subtitle"
                                android:text="Back up every vault, encrypted" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Status block. Only meaningful once an account is attached. -->
                    <LinearLayout
                        android:id="@+id/layoutDriveStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="46dp"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textDriveStored"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Backed up: checking…"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <!-- The number that shows the backup is incremental. -->
                        <TextView
                            android:id="@+id/textDriveToUpload"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Real progress from the worker, not a decorative spinner. -->
                    <LinearLayout
                        android:id="@+id/layoutSyncProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="46dp"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textSyncStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Starting…"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/syncProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:indeterminate="true"
                            app:indicatorColor="@color/brand_yellow"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDriveSyncNow"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/brand_yellow"
                        android:text="Back up now"
                        android:textColor="@color/on_brand_yellow"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSync"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="Back up automatically"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWifiOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Only on Wi-Fi"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDriveAction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Connect Google Drive" />

                    <!-- Restore points. Cheap to keep, so the user sees all of them. -->
                    <TextView
                        android:id="@+id/textRestorePointsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.04"
                        android:text="RESTORE POINTS"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textNoRestorePoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No backups yet. Tap Back up now to make your first one."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRestorePoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textRetentionNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Keeps the latest 3, one a day for 30 days, and any you tap the heart on."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================================= LOCAL BACKUP -->
            <TextView android:id="@+id/headerLocalBackup" style="@style/Settings.Header" android:text="Backup file" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocalBackup"
                style="@style/Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/optionCreateBackup" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_green" android:src="@drawable/ic_save" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Save a backup file" />
                            <TextView style="@style/Settings.Subtitle" android:text="One encrypted .bak to keep or move to a new phone" />
                        </LinearLayout>
                        <ImageView style="@style/Settings.Chevron" />
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout android:id="@+id/optionRestoreData" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_orange" android:src="@drawable/ic_history" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Restore" />
                            <TextView style="@style/Settings.Subtitle" android:text="From a .bak file or Google Drive" />
                        </LinearLayout>
                        <ImageView style="@style/Settings.Chevron" />
                    </LinearLayout>

                    <View style="@style/Settings.Divider" />

                    <LinearLayout android:id="@+id/optionBackupPassword" style="@style/Settings.Row">
                        <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_red" android:src="@drawable/ic_key" />
                        <LinearLayout style="@style/Settings.Texts">
                            <TextView style="@style/Settings.Title" android:text="Backup password" />
                            <TextView
                                android:id="@+id/textBackupPasswordState"
                                style="@style/Settings.Subtitle"
                                android:text="Recommended: PINs are easy to guess offline" />
                        </LinearLayout>
                        <ImageView style="@style/Settings.Chevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/footerLocalBackup"
                style="@style/Settings.Footer"
                android:text="Backups keep running with a notification if you leave the app." />

            <!-- =============================================================== ABOUT -->
            <TextView style="@style/Settings.Header" android:text="About" />

            <com.google.android.material.card.MaterialCardView style="@style/Settings.Card">

                <LinearLayout android:id="@+id/btnCheckUpdates" style="@style/Settings.Row">
                    <ImageView style="@style/Settings.Icon" android:backgroundTint="@color/tile_gray" android:src="@drawable/ic_update" />
                    <LinearLayout style="@style/Settings.Texts">
                        <TextView
                            android:id="@+id/textAppVersion"
                            style="@style/Settings.Title"
                            android:text="Notes+" />
                        <TextView
                            android:id="@+id/textUpdateStatus"
                            style="@style/Settings.Subtitle"
                            android:text="Tap to check for updates" />
                    </LinearLayout>
                    <ImageView style="@style/Settings.Chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
