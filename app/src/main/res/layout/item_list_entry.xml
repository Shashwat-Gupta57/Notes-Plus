<?xml version="1.0" encoding="utf-8"?>
<!-- One list item: drag handle, tick box, the text. Swipe to delete. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/itemHandle"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:contentDescription="Reorder"
        android:padding="8dp"
        android:src="@drawable/ic_note_list"
        app:tint="@color/divider" />

    <CheckBox
        android:id="@+id/itemCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonTint="@color/tile_green" />

    <EditText
        android:id="@+id/itemText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:hint="Item"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_body"
        android:textSize="17sp" />
</LinearLayout>
