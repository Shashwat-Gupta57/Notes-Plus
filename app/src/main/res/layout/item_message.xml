<?xml version="1.0" encoding="utf-8"?>
<!--
  One message. ChatActivity puts it on the right (mine, blue) or the left (theirs). A photo or
  video shows in mediaFrame above the text; the text is hidden when there is none.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txtSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:textColor="@color/tile_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/voiceRow"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnPlayVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="#33FFFFFF"
                android:contentDescription="Play voice message"
                android:padding="9dp"
                android:src="@drawable/ic_play" />

            <view
                class="org.flexstudios.notes.plus.AudioNoteActivity$WaveformView"
                android:id="@+id/voiceWave"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtVoiceLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/mediaFrame"
            android:layout_width="240dp"
            android:layout_height="180dp"
            android:background="@drawable/bubble"
            android:backgroundTint="#33000000"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Photo"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_big"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtMediaInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="#99000000"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:maxWidth="280dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/txtMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
