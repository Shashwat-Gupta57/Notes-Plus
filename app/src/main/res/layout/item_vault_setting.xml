<?xml version="1.0" encoding="utf-8"?>
<!-- One vault in the Settings "Vaults" card: tap to edit, bin to delete (not the main vault). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Settings.Row">

    <ImageView
        style="@style/Settings.Icon"
        android:backgroundTint="@color/tile_purple"
        android:src="@drawable/ic_lock" />

    <LinearLayout style="@style/Settings.Texts">

        <TextView
            android:id="@+id/textVaultName"
            style="@style/Settings.Title"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/textVaultType"
            style="@style/Settings.Subtitle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteVault"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete vault"
        android:src="@drawable/ic_delete"
        app:tint="@color/destructive" />
</LinearLayout>
