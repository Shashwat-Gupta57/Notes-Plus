<?xml version="1.0" encoding="utf-8"?>
<!--
  One gallery cell. Height is set in code to match the column width, so cells stay square at
  any column count. The rounded content scales down when selected; the check sits outside it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <FrameLayout
        android:id="@+id/cellContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cell_background">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/cellScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/cellFavourite"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart_filled"
            android:visibility="gone"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/cellDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/badge_background"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_play"
            app:drawableTint="@color/white" />
    </FrameLayout>

    <ImageView
        android:id="@+id/cellCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle_empty"
        android:visibility="gone" />
</FrameLayout>
