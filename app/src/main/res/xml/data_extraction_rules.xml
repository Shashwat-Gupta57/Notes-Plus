<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing in Notes+ may leave the device through Android's own backup or device transfer.
    The vault files are bound to this phone's Keystore and would be unreadable elsewhere, while
    the database and preferences would carry lock values off the phone. Notes+ has its own
    encrypted backups for moving data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
