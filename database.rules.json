                ".validate": "newData.isNumber() && newData.val() <= 104857600"
              },
              "w": {
                ".validate": "newData.isNumber()"
              },
              "h": {
                ".validate": "newData.isNumber()"
              },
              "dur": {
                ".validate": "newData.isNumber()"
              },
              "wave": {
                ".validate": "newData.isString() && newData.val().length <= 400"
              },
              "once": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "rcv": {
              "$u": {
                ".write": "auth != null && auth.uid === $u && data.parent().parent().exists() && data.parent().parent().parent().parent().child('members').child(auth.uid).exists()",
                ".validate": "newData.val() === now"
              }
            },
            "seen": {
              "$u": {
                ".write": "auth != null && auth.uid === $u && data.parent().parent().exists() && data.parent().parent().parent().parent().child('members').child(auth.uid).exists()",
                ".validate": "newData.val() === now"
              }
            },
            "opened": {
              "$u": {
                ".write": "auth != null && auth.uid === $u && data.parent().parent().exists() && data.parent().parent().parent().parent().child('members').child(auth.uid).exists()",
                ".validate": "newData.val() === now"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groupNotes": {
      "$gid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        "owner": {
          ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com') && !data.exists() && newData.val() === auth.uid && newData.parent().child('members').child(auth.uid).exists()",
          ".validate": "newData.isString()"
        },
        "size": {
          ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com') && (data.parent().child('members').child(auth.uid).exists() || (!data.parent().child('owner').exists() && newData.parent().child('owner').val() === auth.uid))",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
        },
        "members": {
          "$m": {
            ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com') && ((newData.exists() && (data.parent().parent().child('members').child(auth.uid).exists() || (!data.parent().parent().child('owner').exists() && newData.parent().parent().child('owner').val() === auth.uid))) || (!newData.exists() && ($m === auth.uid || data.parent().parent().child('owner').val() === auth.uid)))",
            ".validate": "newData.isString() && root.child('usernames').child(newData.val()).val() === $m && newData.parent().parent().child('size').val() <= 20"
          }
        },
        "note": {
          ".validate": "$gid.matches(/^[0-9a-f]{32}$/) && newData.hasChildren(['rev', 'updatedAt']) && (newData.child('deleted').val() === true || newData.hasChildren(['type'])) && ((!data.exists() && newData.child('rev').val() >= 1) || newData.child('rev').val() === data.child('rev').val() + 1)",
          "rev": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.val() === now"
          },
          "deleted": {
            ".validate": "newData.isBoolean()"
          },
          "type": {
            ".validate": "newData.val().matches(/^(TEXT|LIST|MINDMAP|JOURNAL|SKETCH|AUDIO)$/)"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "data": {
            ".validate": "newData.isString() && newData.val().length <= 1000000"
          },
          "sketch": {
            ".validate": "newData.isString() && newData.val().length <= 1000000"
          },
          "color": {
            ".validate": "newData.isNumber()"
          },
          "pinned": {
            ".validate": "newData.isBoolean()"
          },
          "edited": {
            ".validate": "newData.isNumber()"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "media": {
            "$file": {
              ".validate": "newData.hasChildren(['name', 'driveId', 'size'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "driveId": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "mime": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "size": {
                ".validate": "newData.isNumber()"
              },
              "w": {
                ".validate": "newData.isNumber()"
              },
              "h": {
                ".validate": "newData.isNumber()"
              },
              "durationMs": {
                ".validate": "newData.isNumber()"
              },
              "sha256": {
                ".validate": "newData.isString() && newData.val().length === 64"
              },
              "key": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com') && (data.parent().child('members').child(auth.uid).exists() || (!data.parent().child('owner').exists() && newData.parent().child('owner').val() === auth.uid))"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "groupIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$gid": {
          ".write": "auth != null && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com') && ((newData.exists() && newData.parent().parent().parent().child('groupNotes').child($gid).child('members').child(auth.uid).exists() && newData.parent().parent().parent().child('groupNotes').child($gid).child('members').child($uid).exists()) || (!newData.exists() && root.child('groupNotes').child($gid).child('owner').val() === auth.uid))",
          ".validate": "newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
